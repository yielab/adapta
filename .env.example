# Server Configuration
BRAIN_HOST=0.0.0.0
BRAIN_PORT=8000
BRAIN_WORKERS=1
BRAIN_RELOAD=false

# Paths (relative to project root)
BRAIN_DATA_DIR=./data
BRAIN_MODELS_DIR=./data/models
BRAIN_AGENTS_DIR=./data/agents
BRAIN_CACHE_DIR=./data/cache

# Model Settings
BRAIN_DEFAULT_MODEL=qwen2.5-3b-instruct
BRAIN_MAX_CONTEXT_LENGTH=4096
BRAIN_N_THREADS=8
BRAIN_N_GPU_LAYERS=0
BRAIN_USE_MMAP=true
BRAIN_USE_MLOCK=false

# Inference Settings
BRAIN_TEMPERATURE=0.7
BRAIN_TOP_P=0.9
BRAIN_TOP_K=40
BRAIN_MAX_TOKENS=512
BRAIN_STREAM=true

# RAG Settings
BRAIN_EMBEDDING_MODEL=all-MiniLM-L6-v2
BRAIN_RAG_TOP_K=3
BRAIN_CHUNK_SIZE=512
BRAIN_CHUNK_OVERLAP=50

# API Settings
BRAIN_API_KEY=
BRAIN_CORS_ORIGINS=["*"]

# Performance
BRAIN_MODEL_LOAD_TIMEOUT=300
BRAIN_REQUEST_TIMEOUT=120
BRAIN_MAX_CONCURRENT_REQUESTS=5
