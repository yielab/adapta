# Adapta — environment variables
# Everything has a working local default; copy to .env only to override.
# All vars use the ADAPTA_ prefix (pydantic-settings convention).

# ── Auth ──────────────────────────────────────────────────────────────────────
# Set a real value if the API is ever reachable beyond localhost.
# Generate with: openssl rand -hex 32
#ADAPTA_SECRET_KEY=

# ── Development seed ──────────────────────────────────────────────────────────
# On an EMPTY database, seed a default admin so the console works on first boot
# (a real registration is never clobbered). On by default in docker-compose.yml.
#ADAPTA_SEED_DEFAULT_ADMIN=1
#ADAPTA_DEFAULT_ADMIN_EMAIL=admin@example.com
#ADAPTA_DEFAULT_ADMIN_PASSWORD=admin12345
#ADAPTA_DEFAULT_ADMIN_ORG=Local Dev

# ── Database (Postgres) ───────────────────────────────────────────────────────
ADAPTA_DATABASE_URL=postgresql+asyncpg://adapta:adapta@postgres:5432/adapta

# ── Job queue (Redis) ─────────────────────────────────────────────────────────
ADAPTA_REDIS_URL=redis://redis:6379/0

# ── Vector store (ChromaDB) ───────────────────────────────────────────────────
ADAPTA_CHROMA_HOST=chroma
ADAPTA_CHROMA_PORT=8000

# ── Data directories (mapped as volumes in compose) ───────────────────────────
ADAPTA_DATA_DIR=/app/data
ADAPTA_MODELS_DIR=/app/data/models
ADAPTA_UPLOADS_DIR=/app/data/uploads
ADAPTA_ADAPTERS_DIR=/app/data/adapters
ADAPTA_DATASETS_DIR=/app/data/datasets

# ── Server ────────────────────────────────────────────────────────────────────
ADAPTA_HOST=0.0.0.0
ADAPTA_PORT=8000
ADAPTA_WORKERS=1

# ── Inference (llama-cpp) ─────────────────────────────────────────────────────
ADAPTA_DEFAULT_MODEL=qwen2.5-1.5b-instruct
ADAPTA_MAX_CONTEXT_LENGTH=4096
ADAPTA_N_THREADS=8
# 0 = CPU only; set >0 to offload layers to GPU (requires nvidia-container-toolkit)
ADAPTA_N_GPU_LAYERS=0
ADAPTA_TEMPERATURE=0.7
ADAPTA_TOP_P=0.9
ADAPTA_TOP_K=40
ADAPTA_MAX_TOKENS=512

# ── RAG / embeddings ──────────────────────────────────────────────────────────
# Multilingual default (E3.6). Changing it on a deployment with indexed projects: run
# `docker compose exec app python scripts/reembed.py` BEFORE restarting (OPERATIONS 6.5).
# Alternatives: all-MiniLM-L6-v2 (English-only, smaller) · intfloat/multilingual-e5-small (384d,
# query/passage prefixes applied automatically) · BAAI/bge-m3 (1024d, ~2.3 GB download, heavy)
ADAPTA_EMBEDDING_MODEL=paraphrase-multilingual-MiniLM-L12-v2
ADAPTA_RAG_TOP_K=5
ADAPTA_CHUNK_SIZE=512
ADAPTA_CHUNK_OVERLAP=64
# Hybrid retrieval: vector search (top_k * N candidates) and Postgres full-text search over the
# whole corpus run independently and are fused (RRF); an optional cross-encoder reranks the shortlist.
ADAPTA_RAG_HYBRID_FETCH_MULTIPLIER=4
# Cross-encoder reranker — off by default (the small one is English-only and hurts es/en recall).
# For an English-only corpus: cross-encoder/ms-marco-MiniLM-L-6-v2
ADAPTA_RAG_RERANKER_MODEL=
# Upper bound on the whole retrieval path (vector + full-text + rerank); exceeding it
# degrades to a typed 504 instead of blocking the chat request.
ADAPTA_RAG_TIMEOUT_SECONDS=10

# ── Training ──────────────────────────────────────────────────────────────────
# Minimum eval score for an adapter to be promoted to serving (Pillar 3 gate).
ADAPTA_EVAL_SCORE_THRESHOLD=0.6

# ── CORS ──────────────────────────────────────────────────────────────────────
ADAPTA_CORS_ORIGINS=["*"]

# ── Observability ─────────────────────────────────────────────────────────────
# Log format: "text" (default) or "json" for structured logs to a log aggregator.
ADAPTA_LOG_FORMAT=text
# Expose GET /metrics in Prometheus text format (scraped by the optional
# `observability` compose profile). Set false to disable the endpoint.
ADAPTA_METRICS_ENABLED=true
# Grafana admin password for the observability profile.
GRAFANA_PASSWORD=admin

# ── Postgres password (docker compose service, not the app) ───────────────────
POSTGRES_PASSWORD=adapta
