# Brain From Cero — environment variables
# Everything has a working local default; copy to .env only to override.
# All vars use the BRAIN_ prefix (pydantic-settings convention).

# ── Auth ──────────────────────────────────────────────────────────────────────
# Set a real value if the API is ever reachable beyond localhost.
# Generate with: openssl rand -hex 32
#BRAIN_SECRET_KEY=

# ── Development seed ──────────────────────────────────────────────────────────
# On an EMPTY database, seed a default admin so the console works on first boot
# (a real registration is never clobbered). On by default in docker-compose.yml.
#BRAIN_SEED_DEFAULT_ADMIN=1
#BRAIN_DEFAULT_ADMIN_EMAIL=admin@example.com
#BRAIN_DEFAULT_ADMIN_PASSWORD=admin12345
#BRAIN_DEFAULT_ADMIN_ORG=Local Dev

# ── Database (Postgres) ───────────────────────────────────────────────────────
BRAIN_DATABASE_URL=postgresql+asyncpg://brain:brain@postgres:5432/brain

# ── Job queue (Redis) ─────────────────────────────────────────────────────────
BRAIN_REDIS_URL=redis://redis:6379/0

# ── Vector store (ChromaDB) ───────────────────────────────────────────────────
BRAIN_CHROMA_HOST=chroma
BRAIN_CHROMA_PORT=8000

# ── Data directories (mapped as volumes in compose) ───────────────────────────
BRAIN_DATA_DIR=/app/data
BRAIN_MODELS_DIR=/app/data/models
BRAIN_UPLOADS_DIR=/app/data/uploads
BRAIN_ADAPTERS_DIR=/app/data/adapters
BRAIN_DATASETS_DIR=/app/data/datasets

# ── Server ────────────────────────────────────────────────────────────────────
BRAIN_HOST=0.0.0.0
BRAIN_PORT=8000
BRAIN_WORKERS=1

# ── Inference (llama-cpp) ─────────────────────────────────────────────────────
BRAIN_DEFAULT_MODEL=qwen2.5-3b-instruct
BRAIN_MAX_CONTEXT_LENGTH=4096
BRAIN_N_THREADS=8
# 0 = CPU only; set >0 to offload layers to GPU (requires nvidia-container-toolkit)
BRAIN_N_GPU_LAYERS=0
BRAIN_TEMPERATURE=0.7
BRAIN_TOP_P=0.9
BRAIN_TOP_K=40
BRAIN_MAX_TOKENS=512

# ── RAG / embeddings ──────────────────────────────────────────────────────────
BRAIN_EMBEDDING_MODEL=all-MiniLM-L6-v2
BRAIN_RAG_TOP_K=5
BRAIN_CHUNK_SIZE=512
BRAIN_CHUNK_OVERLAP=64

# ── Training ──────────────────────────────────────────────────────────────────
# Minimum eval score for an adapter to be promoted to serving (Pillar 3 gate).
BRAIN_EVAL_SCORE_THRESHOLD=0.6

# ── CORS ──────────────────────────────────────────────────────────────────────
BRAIN_CORS_ORIGINS=["*"]

# ── Observability ─────────────────────────────────────────────────────────────
# Log format: "text" (default) or "json" for structured logs to a log aggregator.
BRAIN_LOG_FORMAT=text
# Expose GET /metrics in Prometheus text format (scraped by the optional
# `observability` compose profile). Set false to disable the endpoint.
BRAIN_METRICS_ENABLED=true
# Grafana admin password for the observability profile.
GRAFANA_PASSWORD=admin

# ── Postgres password (docker compose service, not the app) ───────────────────
POSTGRES_PASSWORD=brain
