# Caddyfile for Adapta
# Provides local domain access: adapta.test

# Main domain
adapta.test {
    # Reverse proxy to Docker container
    reverse_proxy localhost:8000

    # Enable logging
    log {
        output file /var/log/caddy/adapta.log
        format json
    }

    # CORS headers
    header {
        Access-Control-Allow-Origin *
        Access-Control-Allow-Methods "GET, POST, PUT, DELETE, OPTIONS"
        Access-Control-Allow-Headers "Content-Type, Authorization"
    }
}

# API subdomain
api.adapta.test {
    reverse_proxy localhost:8000

    # API-specific headers
    header {
        Access-Control-Allow-Origin *
        Access-Control-Allow-Methods "GET, POST, PUT, DELETE, OPTIONS"
        Access-Control-Allow-Headers "Content-Type, Authorization"
    }
}

# Dashboard subdomain
dashboard.adapta.test {
    reverse_proxy localhost:8000/dashboard

    header {
        Access-Control-Allow-Origin *
    }
}

# Alternative: www subdomain
www.adapta.test {
    redir https://adapta.test{uri} permanent
}
